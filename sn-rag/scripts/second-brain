#!/usr/bin/env bash
# Launcher for the second brain: splash, preflight, session picker, then exec claude.
#
# Cosmetic on purpose, but the preflight is not: Qdrant down means every search
# fails, and a stale MCP server means sn_get_section returns NOT_FOUND while
# sn_search still works. Both have happened. Better to see it before asking a
# question than to debug it mid-conversation.
#
# Install:  ln -s "$PWD/scripts/second-brain" ~/.local/bin/second-brain
set -uo pipefail

SN_RAG_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PROJECT_DIR="$(dirname "$SN_RAG_DIR")"
SESSION_DIR="$HOME/.claude/projects/$(echo "$PROJECT_DIR" | sed 's|/|-|g')"

# Colour only when attached to a terminal that wants it; NO_COLOR is honoured so
# this stays usable when piped or logged.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  P='\033[38;5;218m'; PB='\033[1;38;5;211m'; DIM='\033[2m'
  OK='\033[38;5;114m'; BAD='\033[38;5;203m'; WARN='\033[38;5;222m'; R='\033[0m'
else
  P=''; PB=''; DIM=''; OK=''; BAD=''; WARN=''; R=''
fi

splash() {
  printf '\n'
  # Quoted heredoc: the art is full of backslashes, backticks and braces, and a
  # single unquoted expansion would mangle it. Each line is passed as an ARGUMENT
  # to printf, never as the format string, so a stray % in future art is inert.
  while IFS= read -r line; do
    printf "${P}    %s${R}\n" "$line"
  done <<'BRAIN'
      _---~~(~~-_.
    _{        )   )
  ,   ) -~~- ( ,-' )_
 (  `-,_..`., )-- '_,)
( ` _)  (  -~( -_ `,  }
(_-  _  ~_-~~~~`,  ,' )
  `~ -^(    __;-,((()))
        ~~~~ {_ -_(())
               `\  }
                 { }
BRAIN
  printf "\n${PB}        S E C O N D   B R A I N${R}\n"
  printf "${DIM}      local retrieval · no paid models${R}\n\n"
}

# --- preflight ---------------------------------------------------------------
# Every check is bounded by a timeout: a hung service must not hang the launcher.
check() {
  local label="$1" state="$2" detail="${3:-}"
  case "$state" in
    ok)   printf "  ${OK}●${R} %-9s ${DIM}%s${R}\n" "$label" "$detail" ;;
    warn) printf "  ${WARN}●${R} %-9s ${DIM}%s${R}\n" "$label" "$detail" ;;
    *)    printf "  ${BAD}●${R} %-9s ${DIM}%s${R}\n" "$label" "$detail" ;;
  esac
}

preflight() {
  local qdrant_state=bad qdrant_detail="not responding on :6333 — searches will fail"
  local points
  points=$(timeout 5 curl -s "http://localhost:6333/collections/knowledge" 2>/dev/null \
           | grep -o '"points_count":[0-9]*' | head -1 | cut -d: -f2)
  if [[ -n "${points:-}" ]]; then
    qdrant_state=ok
    # sed, not printf "%'d" — thousands grouping depends on locale and silently
    # does nothing under LC_ALL=C, which is how this runs from a systemd unit.
    qdrant_detail="$(echo "$points" | sed -e :a -e 's/\(.*[0-9]\)\([0-9]\{3\}\)/\1,\2/;ta') vectors"
  fi
  check "qdrant" "$qdrant_state" "$qdrant_detail"

  if timeout 5 curl -s "http://localhost:11434/api/tags" >/dev/null 2>&1; then
    check "planner" ok "ollama up — sn_research available"
  else
    check "planner" warn "ollama down — sn_research returns PLANNER_UNAVAILABLE"
  fi

  # An indexing job in flight is worth knowing about: it holds EMBED_THREADS
  # cores and the index is incomplete, so recall is a lower bound.
  local prog
  if pgrep -f 'index.py embed' >/dev/null 2>&1; then
    prog=$(tail -1 "$HOME/.local/state/sn-rag/full-embed.log" 2>/dev/null | tr -s ' ' | sed 's/^ //')
    check "indexing" warn "running — ${prog:-in progress}"
  fi
  [[ "$qdrant_state" == ok ]] || printf "  ${DIM}start it with: second-brain --up${R}\n"
  printf '\n'
}

# --- bring services up -------------------------------------------------------
# Only the two long-running units. The MCP server is deliberately NOT started
# here: it speaks MCP over stdin/stdout and is spawned per session by Claude
# Code. A hand-started copy would sit reading your terminal and serve nobody,
# while looking like the system is running.
wait_for() {
  local label="$1" url="$2" tries=30
  while ((tries--)); do
    timeout 2 curl -s "$url" >/dev/null 2>&1 && return 0
    sleep 1
  done
  printf "  ${BAD}%s did not come up within 30s${R}\n" "$label"
  return 1
}

bring_up() {
  local rc=0

  if ! systemctl --user is-active --quiet qdrant.service; then
    printf "  starting qdrant.service\n"
    systemctl --user start qdrant.service || rc=1
    wait_for qdrant "http://localhost:6333/collections" || rc=1
  fi

  # Ollama is optional: only sn_research needs it, and its absence is a clean
  # PLANNER_UNAVAILABLE rather than a broken system. Never treat it as fatal,
  # and never install it from here.
  #
  # Ollama's official installer creates a SYSTEM unit, not a user one, so the
  # user scope is checked second and a system unit is reported rather than
  # started: starting it needs sudo, and a launcher that silently prompts for a
  # root password is worse than one that tells you what to run.
  if ! timeout 2 curl -s "http://localhost:11434/api/tags" >/dev/null 2>&1; then
    if systemctl --user cat ollama.service >/dev/null 2>&1; then
      printf "  starting ollama (user unit)\n"
      systemctl --user start ollama.service 2>/dev/null || true
      wait_for ollama "http://localhost:11434/api/tags" || true
    elif systemctl cat ollama.service >/dev/null 2>&1; then
      printf "  ollama is a system unit — start it with: sudo systemctl start ollama\n"
    else
      printf "  ollama not installed — sn_research unavailable, everything else works\n"
    fi
  fi

  # The timer is enabled at install time; start it if it was stopped by hand.
  systemctl --user is-active --quiet sn-rag-sync.timer \
    || systemctl --user start sn-rag-sync.timer 2>/dev/null || true

  return $rc
}

# --- session picker ----------------------------------------------------------
# Lists recent transcripts newest-first with their opening prompt, because a bare
# UUID tells you nothing about which conversation it was.
list_sessions() {
  [[ -d "$SESSION_DIR" ]] || return 1
  local files=()
  while IFS= read -r f; do files+=("$f"); done < <(ls -t "$SESSION_DIR"/*.jsonl 2>/dev/null | head -9)
  [[ ${#files[@]} -gt 0 ]] || return 1

  SESSION_IDS=()
  local i=1
  for f in "${files[@]}"; do
    local id summary
    id="$(basename "$f" .jsonl)"
    SESSION_IDS+=("$id")
    summary="$(timeout 10 python3 - "$f" <<'PY' 2>/dev/null
import json, os, sys, datetime

# The LAST human prompt, not the first: sessions in one project tend to open the
# same way ("current obsidian vault path: ...") and are told apart by where they
# ended up. Read only the file tail — transcripts reach 7.7 MB and nine of them
# scanned in full would make the launcher feel broken.
TAIL_BYTES = 400_000
path = sys.argv[1]
ts = text = ""
try:
    size = os.path.getsize(path)
    with open(path, "rb") as fh:
        if size > TAIL_BYTES:
            fh.seek(size - TAIL_BYTES)
            fh.readline()  # discard the partial line seek landed in
        lines = fh.read().decode("utf-8", "replace").splitlines()
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") != "user":
            continue
        c = d.get("message", {}).get("content")
        if isinstance(c, list):
            c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
        c = (c or "").strip()
        # Drop tool results, injected context and slash-command plumbing —
        # anything that is not something a person typed.
        if (not c or c[0] in "<[" or c.startswith("Caveat:")
                or c.startswith("Base directory for this skill:")):
            continue
        for marker in ("<system-reminder>", "<local-command", "UserPromptSubmit hook"):
            c = c.split(marker)[0]
        c = " ".join(c.split())
        if c:
            ts, text = d.get("timestamp", ""), c
            break
except OSError:
    pass
when = ""
if ts:
    try:
        when = datetime.datetime.fromisoformat(
            ts.replace("Z", "+00:00")).astimezone().strftime("%d %b %H:%M")
    except ValueError:
        when = ts[:16]
print(f"{when}|{text[:64]}")
PY
)"
    local when="${summary%%|*}" what="${summary#*|}"
    printf "  ${PB}%d${R}  ${DIM}%-13s${R} %s\n" "$i" "${when:-?}" "${what:-(no prompt recorded)}"
    i=$((i + 1))
  done
  return 0
}

usage() {
  splash
  cat <<'USAGE'
  Launcher for the second brain: preflight checks, then a Claude Code session.

  USAGE
    second-brain                 splash, health checks, then pick a session
    second-brain --up            start qdrant (+ ollama), report, then exit
    second-brain --resume <id>   resume directly (any claude flag passes through)
    second-brain --status        health checks only, then exit — no session
    second-brain --down          stop qdrant, ollama and the sync timer
    second-brain --sessions      list recent sessions and exit
    second-brain --help          this text

  SESSION PICKER
    <number>   resume that session
    u          paste a session id
    <id>       type/paste an id directly
    Enter      fresh session

  HEALTH LINE
    qdrant     vector store on :6333. Down means EVERY search fails.
    planner    ollama on :11434. Down means only sn_research fails
               (structured PLANNER_UNAVAILABLE — never a paid fallback).
    indexing   shown only while an embed job is running. The index is
               incomplete during it, so recall is a lower bound.

  NOTES
    Nothing needs starting by hand. Qdrant is a systemd user service and the
    MCP server is spawned per session by Claude Code. NO_COLOR is honoured.

  MORE
    README.md                 install, MCP tools, commands, troubleshooting
                              (repo root — moved up from sn-rag/ to be the
                              GitHub landing page)
    sn-rag/docs/adr/          why things are the way they are
USAGE
}

main() {
  # Parse our own flags BEFORE anything else — --help must not require a TTY,
  # clear the screen, or wait on service checks.
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
    --status)
      splash
      preflight
      exit 0
      ;;
    --up)
      splash
      bring_up
      local up_rc=$?
      preflight
      exit $up_rc
      ;;
    --down)
      # Qdrant only. The corpus and manifest are untouched; this stops services,
      # it does not uninstall anything.
      systemctl --user stop qdrant.service sn-rag-sync.timer 2>/dev/null || true
      systemctl --user stop ollama.service 2>/dev/null || true
      printf "  stopped qdrant, ollama and the sync timer\n"
      exit 0
      ;;
    --sessions)
      list_sessions || printf "  no sessions recorded for this project\n"
      exit 0
      ;;
  esac

  clear 2>/dev/null || true
  splash
  preflight

  cd "$PROJECT_DIR" || exit 1

  # Non-interactive (piped, cron, CI): skip the prompt entirely and pass through.
  if [[ ! -t 0 ]]; then
    exec claude "$@"
  fi

  # Explicit arguments win — `second-brain --resume <id>` behaves like claude.
  if [[ $# -gt 0 ]]; then
    exec claude "$@"
  fi

  local have_sessions=0
  if list_sessions; then
    have_sessions=1
    printf '\n'
  fi

  printf "  ${DIM}number to resume · ${R}u${DIM} to paste a session id · Enter for a fresh session${R}\n"
  printf "  ${PB}>${R} "
  local choice
  read -r choice || choice=""

  case "$choice" in
    "")
      exec claude
      ;;
    u|U)
      printf "  ${DIM}session id:${R} "
      local sid
      read -r sid || sid=""
      [[ -n "$sid" ]] || exec claude
      exec claude --resume "$sid"
      ;;
    *[!0-9]*)
      # Anything non-numeric is treated as a session id typed directly.
      exec claude --resume "$choice"
      ;;
    *)
      if [[ $have_sessions -eq 1 && "$choice" -ge 1 && "$choice" -le ${#SESSION_IDS[@]} ]]; then
        exec claude --resume "${SESSION_IDS[$((choice - 1))]}"
      fi
      printf "  ${BAD}no session %s — starting fresh${R}\n" "$choice"
      exec claude
      ;;
  esac
}

main "$@"
